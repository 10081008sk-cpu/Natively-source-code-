            const msg = `Error: ${err}`;
            if (activeThread === 'screenshot') {
                setScreenshotMessages(prev => prev.map(m =>
                    m.isStreaming ? { ...m, text: msg, isStreaming: false } : m
                ));
            } else {
                setMessages(prev => [...prev, {
                    id: Date.now().toString(),
                    role: 'system',
                    text: msg
                }]);
            }
        } finally {
            setIsProcessing(false);
            const finalAnswer = resultAnswer || "";
