    // ── Smart Transcription Tokenizer ──
    const normalizeTranscription = (text: string): string => {
        let normalized = text.trim();
        // Normalize phonetic transcriptions: "react J's" → "reactjs"
        normalized = normalized.replace(/\breact\s+[Jj]['']s\b/g, 'reactjs');
        normalized = normalized.replace(/\breact\s*[Jj][sS]\b/g, 'reactjs');
        // Fuzzy phonetic keyword mapping: normalize common mis-transcriptions
        normalized = normalized.replace(/\bjava\s*d\b/gi, 'java');          // 'javad' → 'java'
        normalized = normalized.replace(/\bjava\s+in\s+9\b/gi, 'java');     // 'java in 9' → 'java'
        normalized = normalized.replace(/\bjava\s+9\b/gi, 'java');          // 'java 9' → 'java'
        normalized = normalized.replace(/\btype\s+script\b/gi, 'typescript');
        normalized = normalized.replace(/\bnode\s*\.?\s*js\b/gi, 'nodejs');
        normalized = normalized.replace(/\b(python|py)\s*[23]\b/gi, 'python');
        // Strip trailing punctuation, question marks, apostrophes
        normalized = normalized.replace(/[?.!,';:\-]+$/, '');
        return normalized;
    };

    // ── Phantom Silence Refuse Filter ──
    const SILENCE_HALLUCINATIONS = [
        'Thank you.',
        'Tchau.',
        'Gracias.',
        'Obrigado.',
        'Продолжение следует...',
    ];

    // ── Script Hallucination Filter ──
    // Drops tokens containing characters from scripts Whisper spuriously
    // emits (Cyrillic, Sinhalese, Arabic, CJK, etc.) that are outside our
    // supported English / Hindi (Devanagari) / Marathi (Devanagari+Modi) set.
    const UNSUPPORTED_SCRIPT_REGEX = /[\u0400-\u052F\u0D80-\u0DFF\u0600-\u06FF\u0E00-\u0E7F\u4E00-\u9FFF\uAC00-\uD7AF]/;

    // ── Intent Gatekeeper ──
    const QUESTION_PATTERNS = [
        /\b(what is|what are|what's|whats)\b/i,
        /\b(explain|describe|define)\b/i,
        /\b(how (does|would|do|can|should))\b/i,
        /\b(why (does|would|do|is|are))\b/i,
        /\b(tell me about|walk me through)\b/i,
        /\b(design|implement|create|build|write a)\b/i,
        /\b(compare|contrast|difference between)\b/i,
        /\b(list|enumerate|name|mention)\b/i,
    ];

    const scanForQuestionIntent = useCallback((text: string): { isQuestion: boolean; questionText: string } => {
        const trimmed = text.trim();
        const normalized = normalizeTranscription(trimmed);
        for (const pattern of QUESTION_PATTERNS) {
            const match = normalized.match(pattern);
            if (match) {
                const startIdx = match.index ?? 0;
                const questionText = normalized.slice(startIdx).replace(/[?.!]*$/, '').trim();
                return { isQuestion: true, questionText };
            }
        }
        return { isQuestion: false, questionText: '' };
    }, []);

    // ── Acknowledge Buffer ──
    const triggerAcknowledgeBuffer = useCallback((detectedText: string, originalText: string) => {
        if (acknowledgeBuffer.visible) return;
        setAcknowledgeBuffer({ visible: true, detectedText, originalText, countdown: 3 });
        if (acknowledgeTimerRef.current) clearInterval(acknowledgeTimerRef.current);
        acknowledgeTimerRef.current = setInterval(() => {
            setAcknowledgeBuffer(prev => {
                if (prev.countdown <= 1) {
                    if (acknowledgeTimerRef.current) clearInterval(acknowledgeTimerRef.current);
                    acknowledgeTimerRef.current = null;
                    setTimeout(() => {
                        abortControllerRef.current?.abort();
                        abortControllerRef.current = new AbortController();
                        setMessages([]);
                        flushTokenRef.current();
                        setIsProcessing(false);
                        setAcknowledgeBuffer({ visible: false, detectedText: '', originalText: '', countdown: 3 });
                        setInputValue((current: string) => (current + ' ' + detectedText + ' -').trim());
                    }, 0);
                    return { ...prev, visible: false, countdown: 0 };
                }
                return { ...prev, countdown: prev.countdown - 1 };
            });
        }, 1000);
    }, [acknowledgeBuffer.visible, setIsProcessing]);

    const approveQuestion = useCallback(() => {
        if (acknowledgeTimerRef.current) {
            clearInterval(acknowledgeTimerRef.current);
            acknowledgeTimerRef.current = null;
        }
        const text = acknowledgeBuffer.detectedText;
        // Context-Flush: abort any in-flight response and reset canvas
        abortControllerRef.current?.abort();
        abortControllerRef.current = new AbortController();
        setMessages([]);
        flushTokenRef.current();
        setIsProcessing(false);
        setAcknowledgeBuffer({ visible: false, detectedText: '', originalText: '', countdown: 3 });
        setInputValue((current: string) => (current + ' ' + text + ' -').trim());
    }, [acknowledgeBuffer.detectedText, setIsProcessing]);

    const cancelQuestion = useCallback(() => {
