                                            </span>
                                            <div className="flex items-center gap-2">
                                                <button
                                                    onClick={() => setSpeakerMode(prev => prev === 'interviewer' ? 'user' : 'interviewer')}
                                                    className={`px-2 py-0.5 rounded-md text-[10px] font-medium transition-colors ${speakerMode === 'interviewer' ? 'bg-violet-500/20 text-violet-300' : 'bg-emerald-500/20 text-emerald-300'}`}
                                                    title="Toggle who is speaking"
                                                >
                                                    {speakerMode === 'interviewer' ? 'Interviewer' : 'You'}
                                                </button>
                                                <button
                                                    onClick={async () => {
                                                        stopSpeechRecognition();
