                    }
                    return [...prev, { id: Date.now().toString(), role: 'system', text: finalAnswer }];
                });
            } else {
                setMessages(prev => prev.some(m => m.isStreaming)
                    ? prev.map(m => m.isStreaming ? { ...m, isStreaming: false } : m)
