                    (window.electronAPI as any)?.getOnlyInterviewerMode?.() ?? Promise.resolve({ enabled: false }),
                    (window.electronAPI as any)?.getMockInterviewMode?.() ?? Promise.resolve({ enabled: false }),
                    (window.electronAPI as any)?.getNoiseCancellationEnabled?.() ?? Promise.resolve({ enabled: false }),
