    useEffect(() => {
        if (!window.electronAPI?.onSessionReset) return;
        const unsubscribe = window.electronAPI.onSessionReset(() => {
            console.log('[NativelyInterface] Resetting session state...');
            setMessages([]);
            setInputValue('');
            setAttachedContext([]);
            setRollingTranscript('');
            setIsProcessing(false);
            // Optionally reset connection status if needed, but connection persists

            // Track new conversation/session if applicable?
            // Actually 'app_opened' is global, 'assistant_started' is overlay.
            // Maybe 'conversation_started' event?
            analytics.trackConversationStarted();
        });
        return () => unsubscribe();
    }, []);


    const handleScreenshotAttach = (data: { path: string; preview: string }) => {
        // Guard: reject invalid screenshot data before processing
        if (!data || !data.path || typeof data.path !== 'string' || data.path.trim().length === 0) {
            console.warn('[NativelyInterface] handleScreenshotAttach: invalid screenshot data rejected', data);
            return;
        }
        setIsExpanded(true);
        setActiveThread('screenshot');

        // Add screenshot as user message in the dedicated screenshot thread
        setScreenshotMessages(prev => [...prev, {
            id: `ss-user-${Date.now()}`,
            role: 'user',
            text: 'What is on this screen?',
            hasScreenshot: true,
            screenshotPreview: data.preview,
            screenshotPath: data.path
        }]);

        // Store screenshot in a stable ref BEFORE updating React state.
        pendingCaptureRef.current = data;

        setAttachedContext(prev => {
            if (prev.some(s => s.path === data.path)) return prev;
            const updated = [...prev, data];
            return updated.slice(-5);
        });

        // BUG-2: setActiveThread('screenshot') above is async — React hasn't
        // flushed yet when handleWhatToSay runs synchronously next. The ref
        // guarantees the screenshot thread branch is taken regardless of
        // whether activeThread state has caught up.
        isScreenshotAnalysisRef.current = true;
        handlersRef.current.handleWhatToSay();
    };

    // STT Status listener — must survive isExpanded changes.
    // If registered inside the [isExpanded] effect, events are dropped during cleanup.
    useEffect(() => {
        return window.electronAPI.onSttStatusChanged((data) => {
            if (data.channel === 'user') {
                setSttUserStatus(data.state);
                setSttUserProvider(data.provider);
                if (data.error) setSttUserError(data.error);
                if (data.state === 'connected') setSttUserError('');
            } else if (data.channel === 'interviewer') {
                setSttInterviewerStatus(data.state);
                setSttInterviewerProvider(data.provider);
                if (data.error) setSttInterviewerError(data.error);
                if (data.state === 'connected') setSttInterviewerError('');
            }
        });
    }, []);

    // ── DUAL-BUFFER STREAMING ENGINE ─────────────────────────────────────────
    //
    // Architecture: two reference layers decouple raw token capture from visible
    // UI updates, preventing layout reshuffling and excessive re-renders.
    //
    //   hiddenBufRef  (hidden accumulator)
    //       ↓  micro-throttle every ~150ms, line-complete flush
    //   setMessages  (visible UI layer)
    //
    // hiddenBufRef captures every incoming token immediately — no state calls,
    // no renders. A micro-throttle loop (DUAL_BUF_THROTTLE_MS = 150ms) then
    // extracts *complete lines* (text before the last `\n`) and flushes only
    // those to setMessages, keeping any trailing partial line in the hidden
    // buffer for the next tick. This means:
    //   • At most ~6 setMessages/sec instead of 60+ (rAF) or 400+ (per-token)
    //   • Each flush contains whole lines, so ReactMarkdown and code highlighters
    //     re-render on clean line boundaries — no mid-line layout jitter
    //   • The final flushToken() call (stream end) force-releases everything
    //     including any trailing partial line
    //
    // Single-buffer-pair design (not per-intent) is fine because LLM streams
    // never overlap by intent in this app. If the intent changes mid-stream we
    // synchronously flush the prior intent's hidden buffer before queuing.
    const DUAL_BUF_THROTTLE_MS = 150;
    const hiddenBufRef = useRef<{ intent: string; text: string; timer: ReturnType<typeof setTimeout> | null }>({ intent: '', text: '', timer: null });

    // Flush only complete lines from hidden → visible. The last partial line
    // (after the final `\n`) stays in hiddenBufRef for the next throttle tick.
    // This guarantees every setMessages contains whole lines — zero mid-line
    // layout shifts in the markdown / code-highlight render path.
    const flushHiddenToVisible = useCallback(() => {
        const hidden = hiddenBufRef.current;
        if (!hidden.text) return;
        const lastNewline = hidden.text.lastIndexOf('\n');
        if (lastNewline < 0) return; // no complete line yet — keep accumulating
        const completeText = hidden.text.slice(0, lastNewline + 1);
        const remaining = hidden.text.slice(lastNewline + 1);
        hidden.text = remaining;
        const intent = hidden.intent;
        reactStartTransition(() => {
            setMessages(prev => {
                const lastMsg = prev[prev.length - 1];
                if (lastMsg && lastMsg.isStreaming && lastMsg.intent === intent) {
                    const updated = [...prev];
                    updated[prev.length - 1] = { ...lastMsg, text: lastMsg.text + completeText };
                    return updated;
                }
                return [...prev, { id: Date.now().toString(), role: 'system', text: completeText, intent, isStreaming: true }];
            });
        });
    }, []);

    const scheduleHiddenFlush = useCallback(() => {
        const hidden = hiddenBufRef.current;
        if (hidden.timer !== null) return;
        hidden.timer = setTimeout(() => {
            hidden.timer = null;
            flushHiddenToVisible();
            if (hidden.text) scheduleHiddenFlush();
        }, DUAL_BUF_THROTTLE_MS);
    }, [flushHiddenToVisible]);

    // queueToken — appends a token to the hidden accumulator and schedules
    // the micro-throttle flush. If the intent changes, the prior intent's
    // hidden text is force-flushed immediately to prevent cross-intent
    // text mixing (hidden buffer has no intent guard otherwise).
    const queueToken = useCallback((intent: string, token: string) => {
        const hidden = hiddenBufRef.current;
        if (hidden.text && hidden.intent !== intent) {
            const oldText = hidden.text;
            const oldIntent = hidden.intent;
            hidden.text = '';
            if (hidden.timer !== null) { clearTimeout(hidden.timer); hidden.timer = null; }
            reactStartTransition(() => {
                setMessages(prev => {
                    const lastMsg = prev[prev.length - 1];
                    if (lastMsg && lastMsg.isStreaming && lastMsg.intent === oldIntent) {
                        const updated = [...prev];
                        updated[prev.length - 1] = { ...lastMsg, text: lastMsg.text + oldText };
                        return updated;
                    }
                    return [...prev, { id: Date.now().toString(), role: 'system', text: oldText, intent: oldIntent, isStreaming: true }];
                });
            });
        }
        hidden.intent = intent;
        hidden.text += token;
        scheduleHiddenFlush();
    }, [scheduleHiddenFlush]);

    // flushToken — force-releases ALL remaining hidden text (including any
    // trailing partial line) to the visible UI. Called by every "final answer"
    // IPC handler BEFORE it applies its own setMessages, so no tokens are
    // ever lost on stream completion. NOT wrapped in startTransition so the
    // final tokens land in DOM before the final-answer state commit.
    const flushToken = useCallback(() => {
        const hidden = hiddenBufRef.current;
        if (hidden.timer !== null) { clearTimeout(hidden.timer); hidden.timer = null; }
        if (!hidden.text) return;
        const text = hidden.text;
        const intent = hidden.intent;
        hidden.text = '';
        setMessages(prev => {
            const lastMsg = prev[prev.length - 1];
            if (lastMsg && lastMsg.isStreaming && lastMsg.intent === intent) {
                const updated = [...prev];
                updated[prev.length - 1] = { ...lastMsg, text: lastMsg.text + text };
                return updated;
            }
            return [...prev, { id: Date.now().toString(), role: 'system', text, intent, isStreaming: true }];
        });
    }, []);

    flushTokenRef.current = flushToken;

    // Connect to Native Audio Backend
    useEffect(() => {
        const cleanups: (() => void)[] = [];

        // Connection Status
        window.electronAPI.getNativeAudioStatus().then((status) => {
            setIsConnected(status.connected);
        }).catch(() => setIsConnected(false));

        cleanups.push(window.electronAPI.onNativeAudioConnected(() => {
            setIsConnected(true);
        }));
        cleanups.push(window.electronAPI.onNativeAudioDisconnected(() => {
            setIsConnected(false);
        }));

        // Real-time Transcripts
        cleanups.push(window.electronAPI.onNativeAudioTranscript((transcript) => {
            // Only show interviewer (system audio) transcripts in rolling bar
            if (transcript.speaker !== 'interviewer') {
                return;
            }

            setIsInterviewerSpeaking(!transcript.final);

            if (transcript.final) {
                setRollingTranscript(prev => {
                    const separator = prev ? '  ·  ' : '';
                    return prev + separator + transcript.text;
                });

                setTimeout(() => {
                    setIsInterviewerSpeaking(false);
                }, 3000);
            } else {
                // For partial transcripts, show current segment appended to accumulated
                setRollingTranscript(prev => {
                    // Find where previous finalized content ends (look for last separator)
                    const lastSeparator = prev.lastIndexOf('  ·  ');
                    const accumulated = lastSeparator >= 0 ? prev.substring(0, lastSeparator + 5) : '';
                    return accumulated + transcript.text;
                });
            }
        }));

        // AI Suggestions from native audio (legacy)
        cleanups.push(window.electronAPI.onSuggestionProcessingStart(() => {
            setIsProcessing(true);
            setIsExpanded(true);
        }));

        cleanups.push(window.electronAPI.onSuggestionGenerated((data) => {
            setIsProcessing(false);
            setMessages(prev => [...prev, {
                id: Date.now().toString(),
                role: 'system',
                text: data.suggestion
            }]);
        }));

        cleanups.push(window.electronAPI.onSuggestionError((err) => {
            setIsProcessing(false);
            setMessages(prev => [...prev, {
                id: Date.now().toString(),
                role: 'system',
                text: `Error: ${err.error}`
            }]);
        }));



        cleanups.push(window.electronAPI.onIntelligenceSuggestedAnswerToken((data) => {
            // Coaching now arrives via onIntelligenceNegotiationCoaching only —
            // sentinel detection on this stream has been removed.
            if (isScreenshotAnalysisRef.current) {
                // Enhancement 3: route streaming tokens to screenshot thread
                setScreenshotMessages(prev => {
                    const lastMsg = prev[prev.length - 1];
                    if (lastMsg && lastMsg.isStreaming && lastMsg.intent === 'what_to_answer') {
                        const updated = [...prev];
                        updated[prev.length - 1] = { ...lastMsg, text: lastMsg.text + data.token };
                        return updated;
                    }
                    return [...prev, {
                        id: `ss-token-${Date.now()}`,
                        role: 'system',
                        text: data.token,
                        intent: 'what_to_answer',
                        isStreaming: true
                    }];
                });
            } else {
                queueToken('what_to_answer', data.token);
            }
        }));

        cleanups.push(window.electronAPI.onIntelligenceSuggestedAnswer((data) => {
            // PERF: flush any tokens still pending in the rAF buffer onto the
            // streaming row BEFORE we apply the final-answer setMessages, so no
            // tokens are lost on stream completion.
            flushToken();
            setIsProcessing(false);

            const wasScreenshotAnalysis = isScreenshotAnalysisRef.current;
            isScreenshotAnalysisRef.current = false;

            if (wasScreenshotAnalysis) {
                // Enhancement 3: finalize screenshot thread message
