                setMessages(prev => [...prev, {
                    id: Date.now().toString(),
                    role: 'user',
                    text: 'What should I say about this?',
                    hasScreenshot: true,
                    screenshotPreview: currentAttachments[0].preview
                }]);
            }
            requestAnimationFrame(() => {
                const container = scrollContainerRef.current;
                if (container) container.scrollTop = container.scrollHeight;
            });
        }

        const mode = screenshotAnalysisMode === 'auto' ? 'general' : screenshotAnalysisMode;
        const modePrompt = mode === 'code-review'
            ? `Review this code for bugs, performance issues, security vulnerabilities, style improvements, and adherence to best practices. Identify the programming language, explain what the code does, and suggest concrete improvements with code examples.`
            : mode === 'dsa'
                ? `Analyze this DSA (Data Structures & Algorithms) problem. Identify the problem type, input/output format, constraints, edge cases, and the optimal algorithmic approach. Provide a solution in ${dsaLanguage} with time and space complexity analysis. Walk through the algorithm step by step with a small example.`
                : mode === 'error'
                    ? `Analyze this error message or debugging screenshot. Identify the error type, root cause, affected components, and provide step-by-step debugging instructions and a concrete fix. Include prevention tips for the future.`
                    : `Analyze the attached image comprehensively. If it contains code, identify the language/libraries, describe what the program does, what output it produces, and provide a detailed code analysis covering structure, logic, algorithms, and improvements. If it shows a natural scene, photograph, diagram, UI, text, or any other content, describe everything visible in detail including objects, people, text, colors, layout, and context. Provide a complete, thorough analysis of the image content.`;
        const imageAnalysisInstruction = `[Analysis mode: ${mode === 'dsa' ? `${mode} (language: ${dsaLanguage})` : mode}]\n${modePrompt}`;
        const effectiveInstruction = dynamicPromptInstruction || (hasScreenshots ? imageAnalysisInstruction : undefined);

        let resultAnswer: string | null = null;
        try {
            const result = await window.electronAPI.generateWhatToSay(
                undefined,
                hasScreenshots ? currentAttachments.map(s => s.path) : undefined,
                effectiveInstruction ? { promptInstruction: effectiveInstruction } : undefined
            );
            setScreenContextStatus(result.screenContextStatus || 'not_available');
            setLatestUsedImageInput(Boolean(result.usedImageInput));
            setLatestVisionProviderUsed(result.visionProviderUsed);
            setLatestVisionModelUsed(result.visionModelUsed);
            setLatestVisionFailureReason(result.visionFailureReason);
            resultAnswer = result.answer;

            if (result.detectedScreenType) {
                setVisionStatus({ status: 'classified', detail: `Detected: ${result.detectedScreenType}` });
                // Auto-classify: map detectedScreenType to analysis mode for subsequent analyses
                const detectedType = result.detectedScreenType.toLowerCase();
                if (detectedType.includes('code') || detectedType.includes('review')) {
                    if (screenshotAnalysisMode === 'auto') setScreenshotAnalysisMode('code-review');
                } else if (detectedType.includes('dsa') || detectedType.includes('problem') || detectedType.includes('algorithm') || detectedType.includes('leetcode') || detectedType.includes('coding')) {
                    if (screenshotAnalysisMode === 'auto') setScreenshotAnalysisMode('dsa');
                } else if (detectedType.includes('error') || detectedType.includes('terminal') || detectedType.includes('stack') || detectedType.includes('log') || detectedType.includes('exception') || detectedType.includes('crash') || detectedType.includes('debug')) {
                    if (screenshotAnalysisMode === 'auto') setScreenshotAnalysisMode('error');
