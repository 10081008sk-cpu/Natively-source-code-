                                    {/* ── Screenshot Thread ── */}
                                    {activeThread === 'screenshot' && screenshotMessages.map((msg) => (
                                        <MessageRow
                                            key={msg.id}
                                            msg={msg}
                                            isLightTheme={isLightTheme}
