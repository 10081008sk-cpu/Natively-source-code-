                                    {/* ── Chat Thread (Accordion) ── */}
                                    {activeThread === 'chat' && messages.map((msg, index) => {
                                        const isLatest = index === messages.length - 1;
                                        const isExpanded = isLatest || expandedCardIndex === index;

                                        if (isExpanded) {
                                            return (
                                                <MessageRow
                                                    key={msg.id}
                                                    msg={msg}
                                                    isLightTheme={isLightTheme}
                                                    appearance={appearance}
                                                    onCopy={handleCopy}
                                                    renderMessageText={renderMessageText}
                                                />
                                            );
                                        }

                                        const roleIcon = msg.role === 'user' ? '💬' : msg.role === 'interviewer' ? '🎤' : '🤖';
                                        const cleanPreview = msg.text.replace(/```[\s\S]*?```/g, '[code]');
                                        const previewText = cleanPreview.length > 55
                                            ? cleanPreview.slice(0, 55) + '…'
                                            : cleanPreview || '(empty)';

                                        return (
                                            <div key={msg.id}>
                                                <div
                                                    onClick={() => setExpandedCardIndex(expandedCardIndex === index ? null : index)}
                                                    className="flex items-center gap-2 px-3 py-2 rounded-lg border cursor-pointer transition-all hover:opacity-80 overlay-subtle-surface"
                                                    style={appearance.subtleStyle}
                                                >
                                                    <span className="text-[13px] shrink-0">{roleIcon}</span>
                                                    <span className="text-[12px] overlay-text-muted truncate flex-1 min-w-0">
                                                        {previewText}
                                                    </span>
                                                    <span className="text-[10px] overlay-text-muted opacity-50 shrink-0 whitespace-nowrap">
                                                        Click to expand
