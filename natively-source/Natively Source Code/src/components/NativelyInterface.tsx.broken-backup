        const creds = await window.electronAPI.getStoredCredentials?.().catch(() => null);
        const useGroq = creds && creds.sttProvider === 'groq';

        if (useGroq) {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            const audioContext = new AudioContext();
            const source = audioContext.createMediaStreamSource(stream);
            const pcmChunks: Float32Array[] = [];
            let processor: ScriptProcessorNode | null = null;

            try {
                processor = audioContext.createScriptProcessor(4096, 1, 1);
                processor.onaudioprocess = (e) => {
                    pcmChunks.push(new Float32Array(e.inputBuffer.getChannelData(0)));
                };
                source.connect(processor);
                processor.connect(audioContext.destination);
            } catch {
                setLiveError('Audio processing not available.');
                stream.getTracks().forEach(t => t.stop());
                return;
            }

            const transcriptionInterval = setInterval(async () => {
                if (pcmChunks.length === 0) return;
                const captured = pcmChunks.splice(0, pcmChunks.length);
                const totalLen = captured.reduce((s, c) => s + c.length, 0);
                const combined = new Float32Array(totalLen);
                let off = 0;
                for (const c of captured) { combined.set(c, off); off += c.length; }
                const wavBuffer = encodeWavPcm(combined, audioContext.sampleRate);
                const bytes = new Uint8Array(wavBuffer);
                let binary = '';
                const chunkSize = 8192;
                for (let i = 0; i < bytes.length; i += chunkSize) {
                    binary += String.fromCharCode(...bytes.slice(i, i + chunkSize));
                }
                const base64 = btoa(binary);
                const result = await window.electronAPI.transcribeLiveAudio?.(base64).catch(() => null);
                if (result?.success && result.text) {
                    handleLiveTranscript(result.text, speakerMode);
                }
            }, 3000);

            (audioContext as any).__interval = transcriptionInterval;
            (audioContext as any).__stream = stream;
            (audioContext as any).__processor = processor;
            speechRecognitionRef.current = audioContext;
        } else {
            const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
            if (!SpeechRecognition) {
                setLiveError('Speech recognition not available in this browser.');
                return;
            }
            const recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';
            recognition.onresult = (event: any) => {
                let finalText = '';
                for (let i = event.resultIndex; i < event.results.length; i++) {
                    if (event.results[i].isFinal) {
                        finalText += event.results[i][0].transcript;
                    }
                }
                if (finalText) {
                    handleLiveTranscript(finalText, speakerMode);
                }
            };
            recognition.onerror = (event: any) => {
                console.error('[Live] Speech recognition error:', event.error);
                if (event.error === 'not-allowed') setLiveError('Microphone permission denied.');
            };
            recognition.onend = () => {
                if (liveInterviewActive) {
                    try { recognition.start(); } catch {
                        setLiveError('Speech recognition failed to restart.');
                    }
                }
            };
            recognition.start();
            speechRecognitionRef.current = recognition;
        }
    }, [speakerMode, liveInterviewActive, handleLiveTranscript]);

    const stopSpeechRecognition = useCallback(() => {
