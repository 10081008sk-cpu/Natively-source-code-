// ── Input sanitization ─────────────────────────────────────────────────
function sanitizeInput(text: string): string {
    let s = text.trim();
    // Strip HTML tags
    s = s.replace(/<[^>]*>/g, '');
    // Remove control characters except newlines and tabs
    s = s.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
    return s;
}

function stripSystemInstructions(text: string): string {
    let s = text;
    // Remove content between [system]...[/system] markers
    s = s.replace(/\[system\][\s\S]*?\[\/system\]/gi, '');
    // Remove content between <!-- ... --> HTML comments
    s = s.replace(/<!--[\s\S]*?-->/g, '');
    // Remove leading "System:" or "Assistant:" role prefixes
    s = s.replace(/^(System|Assistant):\s*/i, '');
    return s.trim();
}

