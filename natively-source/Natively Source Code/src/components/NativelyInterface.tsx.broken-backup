        const pending = pendingCaptureRef.current;
        pendingCaptureRef.current = null;
        let currentAttachments = attachedContext;
        if (pending && !currentAttachments.some(s => s.path === pending.path)) {
            currentAttachments = [...currentAttachments, pending].slice(-5);
        }
        // Guard: filter out attachments with invalid/missing paths before sending
        currentAttachments = currentAttachments.filter(s => s.path && typeof s.path === 'string' && s.path.trim().length > 0);

        const hasScreenshots = currentAttachments.length > 0;

        if (currentAttachments.length > 0) {
            setAttachedContext([]);

            // BUG-2: activeThread may be stale due to React batching; also
            // check the ref that handleScreenshotAttach sets synchronously.
            if (activeThread === 'screenshot' || isScreenshotAnalysisRef.current) {
                isScreenshotAnalysisRef.current = true;
                setScreenshotMessages(prev => [...prev, {
                    id: `ss-assistant-${Date.now()}`,
                    role: 'system',
                    text: '',
                    intent: 'what_to_answer',
                    isStreaming: true
